# true = corre sin AWS (embeddings y parser simulados). Ideal para estudiar.
# false = usa Amazon Bedrock de verdad (necesita credenciales AWS).
USE_MOCK=true

# Clave que Next manda en el header X-Api-Key. Obligatoria con USE_MOCK=false.
# Generala con: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

AWS_REGION=us-east-1

# Modelo de embeddings (Amazon Titan Text Embeddings V2)
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=512

# LLM para interpretar la búsqueda y redactar la respuesta.
# Verificá el ID exacto en la consola de Bedrock > Model catalog (o Inference profiles).
LLM_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Inventario. Con INVENTORY_URL se pide al endpoint interno de Next
# (p. ej. https://tu-sitio.vercel.app/api/ia/inventario) con el secreto como
# Bearer. Sin URL se lee DATA_PATH, que es lo que usan los tests.
INVENTORY_URL=
INVENTORY_SECRET=
DATA_PATH=data/inventario.json
