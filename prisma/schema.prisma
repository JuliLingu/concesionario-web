generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  relationMode = "prisma"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Categoria {
  id        String     @id @default(cuid())
  nombre    String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  vehiculos Vehiculo[]

  @@map("categorias")
}

model Vehiculo {
  id                     String                  @id @default(cuid())
  categoriaId            String
  marca                  String
  modelo                 String
  anio                   Int
  version                String?
  estado                 EstadoVehiculo          @default(USADO)
  precio                 Decimal                 @db.Decimal(12, 2)
  moneda                 Moneda                  @default(USD)
  kilometraje            Int                     @default(0)
  color                  String?
  motor                  String?
  transmision            Transmision?
  combustible            Combustible?
  puertas                Int?
  potencia               Int?
  descripcion            String?                 @db.Text
  publicacion            EstadoPublicacion       @default(BORRADOR)
  // Opt-in a la financiación: los planes son globales, así que sin esta marca
  // cualquier alta nueva entraría sola al simulador. Apagado por defecto, la
  // unidad se ofrece solo al contado hasta que el administrador diga lo contrario.
  financiable            Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  categoria              Categoria               @relation(fields: [categoriaId], references: [id])
  imagenes               ImagenVehiculo[]
  consultas              Consulta[]
  solicitudesFinanciacion SolicitudFinanciacion[]
  tasaciones             Tasacion[]

  @@index([categoriaId])
  @@index([publicacion])
  @@index([marca, modelo])
  @@map("vehiculos")
}

model ImagenVehiculo {
  id          String   @id @default(cuid())
  vehiculoId  String
  url         String   @db.Text
  altText     String?
  orden       Int      @default(0)
  esPrincipal Boolean  @default(false)
  createdAt   DateTime @default(now())
  vehiculo    Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)

  @@index([vehiculoId])
  @@map("imagenes_vehiculos")
}

model Consulta {
  id         String         @id @default(cuid())
  vehiculoId String?
  nombre     String
  email      String
  telefono   String?
  mensaje    String?        @db.Text
  estado     EstadoConsulta @default(PENDIENTE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  vehiculo   Vehiculo?      @relation(fields: [vehiculoId], references: [id], onDelete: SetNull)

  @@index([vehiculoId])
  @@index([estado])
  @@map("consultas")
}

model Configuracion {
  id                  String   @id @default("1")
  // Sin default: el nombre siempre llega del formulario de configuración, que
  // lo exige no vacío. No hay ninguna concesionaria escrita en el esquema.
  nombreConcesionaria String
  telefono            String?
  email               String?
  direccion           String?
  facebookUrl         String?
  instagramUrl        String?
  horariosAtencion    String?
  updatedAt           DateTime @updatedAt
  cotizacionDolar     Decimal? @db.Decimal(10, 2)

  // Precios a la vista. Cada concesionaria decide si publica el importe de sus
  // unidades: con `false` el precio deja de pedirse en el alta y de mostrarse en
  // todo el sitio, pero el valor ya cargado sigue guardado en cada vehículo.
  mostrarPrecios Boolean @default(true)

  // Identidad visual
  logoUrl    String? @db.Text
  faviconUrl String? @db.Text

  // SEO / metadata del layout
  siteTitle       String?
  siteDescription String? @db.Text

  // Portada (Hero)
  heroTitulo    String?
  heroSubtitulo String?
  heroCtaTexto  String?
  heroCtaUrl    String?
  heroImagenUrl String? @db.Text

  // Nosotros (CompanyInfo)
  nosotrosTitulo         String? @db.Text
  nosotrosTexto          String? @db.Text
  nosotrosMetrica1Valor  String?
  nosotrosMetrica1Sufijo String?
  nosotrosMetrica1Label  String?
  nosotrosMetrica2Valor  String?
  nosotrosMetrica2Sufijo String?
  nosotrosMetrica2Label  String?

  // Financiación. El módulo entero (sección de portada, simulador, planes y
  // solicitudes) se enciende desde Configuración. Arranca apagado: la
  // concesionaria que no financia no ve nada del tema en el sitio ni en el panel.
  financiacionActiva Boolean  @default(false)
  finanEyebrow       String?
  finanTitulo        String?  @db.Text
  finanTexto         String?  @db.Text
  finanTasaAnual     Decimal? @db.Decimal(5, 2)
  finanEntregaMinima Decimal? @db.Decimal(5, 2)
  finanCtaTexto      String?

  // Tasación de usados. Igual que financiación, el módulo entero (formulario
  // público, bandeja del panel y avisos) se enciende desde Configuración y
  // arranca apagado: la concesionaria que no toma usados no ve nada del tema, y
  // ninguna instalación ya entregada empieza a juntar propuestas que nadie mira.
  tasacionActiva   Boolean @default(false)
  tasacionEyebrow  String?
  tasacionTitulo   String? @db.Text
  tasacionTexto    String? @db.Text
  tasacionCtaTexto String?

  // Consulta por unidad (ficha de vehículo)
  contactoEyebrow       String?
  contactoTitulo        String? @db.Text
  contactoTexto         String? @db.Text
  contactoWhatsappTexto String?

  // Pie de página
  footerTexto   String?
  terminosUrl   String?
  privacidadUrl String?

  // Paleta del sitio (hex #rrggbb). Null = se usa el color por defecto.
  colorPrimario           String? @db.VarChar(7)
  colorAcento             String? @db.VarChar(7)
  colorFondo              String? @db.VarChar(7)
  colorSuperficie         String? @db.VarChar(7)
  colorTexto              String? @db.VarChar(7)
  colorTextoSuave         String? @db.VarChar(7)
  colorTextoSobrePrimario String? @db.VarChar(7)

  @@map("configuraciones")
}

enum Role {
  USER
  ADMIN
}

enum EstadoVehiculo {
  NUEVO
  USADO
}

enum Moneda {
  ARS
  USD
}

enum EstadoPublicacion {
  BORRADOR
  PUBLICADO
  VENDIDO
  PAUSADO
}

enum Transmision {
  MANUAL
  AUTOMATICA
  CVT
}

enum Combustible {
  NAFTA
  DIESEL
  ELECTRICO
  HIBRIDO
  GNC
}

enum EstadoConsulta {
  PENDIENTE
  VISTA
  RESPONDIDA
  CERRADA
}

model PlanFinanciacion {
  id        String   @id @default(cuid())
  nombre    String
  cuotas    Int
  tasaAnual Decimal  @db.Decimal(5, 2)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("planes_financiacion")
}

/**
 * Usado que un visitante ofrece al concesionario.
 *
 * Tabla propia y no un `Vehiculo` con campos en null: un vehículo es stock
 * —tiene precio, estado de publicación, categoría e imágenes propias— y una
 * tasación es lo que un desconocido dice de un auto que todavía no es de nadie.
 * Mezclarlas obligaría a aflojar media docena de campos obligatorios y a
 * filtrar por estado en cada consulta del catálogo.
 *
 * Por lo mismo, marca y modelo son texto libre y no apuntan a `Categoria`: esa
 * taxonomía es interna del concesionario y quien completa el formulario no
 * tiene por qué conocerla.
 */
model Tasacion {
  id String @id @default(cuid())

  // Quién ofrece. El teléfono es obligatorio: una tasación se cierra llamando.
  nombre   String
  email    String
  telefono String

  // Qué ofrece.
  marca       String
  modelo      String
  anio        Int
  kilometraje Int
  version     String?
  combustible Combustible?
  transmision Transmision?

  // Lo que espera cobrar. Opcional a propósito: mucha gente no tiene idea de
  // cuánto vale su auto, y exigirlo es perder la mitad de los formularios.
  precioPretendido Decimal? @db.Decimal(12, 2)
  moneda           Moneda   @default(USD)
  observaciones    String?  @db.Text

  // Unidad del catálogo por la que quiere permutar. Es lo que convierte una
  // tasación en una venta y no solo en una compra. SetNull igual que en
  // Consulta: si la unidad se da de baja, la tasación sobrevive.
  vehiculoInteresId String?
  vehiculoInteres   Vehiculo? @relation(fields: [vehiculoInteresId], references: [id], onDelete: SetNull)

  estado    EstadoConsulta @default(PENDIENTE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([vehiculoInteresId])
  @@index([estado])
  @@map("tasaciones")
}

model SolicitudFinanciacion {
  id         String         @id @default(cuid())
  vehiculoId String?
  nombre     String
  apellido   String
  dni        String
  email      String
  telefono   String
  ingresos   Decimal?       @db.Decimal(12, 2)
  anticipo   Decimal        @db.Decimal(12, 2)
  cuotas     Int
  estado     EstadoConsulta @default(PENDIENTE)
  mensaje    String?        @db.Text
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  vehiculo   Vehiculo?      @relation(fields: [vehiculoId], references: [id], onDelete: SetNull)

  @@index([vehiculoId])
  @@index([estado])
  @@map("solicitudes_financiacion")
}
