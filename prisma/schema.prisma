generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  relationMode = "prisma"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Categoria {
  id        String     @id @default(cuid())
  nombre    String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  vehiculos Vehiculo[]

  @@map("categorias")
}

model Vehiculo {
  id                     String                  @id @default(cuid())
  categoriaId            String
  marca                  String
  modelo                 String
  anio                   Int
  version                String?
  estado                 EstadoVehiculo          @default(USADO)
  precio                 Decimal                 @db.Decimal(12, 2)
  kilometraje            Int                     @default(0)
  color                  String?
  motor                  String?
  transmision            Transmision?
  combustible            Combustible?
  puertas                Int?
  potencia               Int?
  descripcion            String?                 @db.Text
  publicacion            EstadoPublicacion       @default(BORRADOR)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  categoria              Categoria               @relation(fields: [categoriaId], references: [id])
  imagenes               ImagenVehiculo[]
  consultas              Consulta[]
  solicitudesFinanciacion SolicitudFinanciacion[]

  @@index([categoriaId])
  @@index([publicacion])
  @@index([marca, modelo])
  @@map("vehiculos")
}

model ImagenVehiculo {
  id          String   @id @default(cuid())
  vehiculoId  String
  url         String   @db.Text
  altText     String?
  orden       Int      @default(0)
  esPrincipal Boolean  @default(false)
  createdAt   DateTime @default(now())
  vehiculo    Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)

  @@index([vehiculoId])
  @@map("imagenes_vehiculos")
}

model Consulta {
  id         String         @id @default(cuid())
  vehiculoId String?
  nombre     String
  email      String
  telefono   String?
  mensaje    String?        @db.Text
  estado     EstadoConsulta @default(PENDIENTE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  vehiculo   Vehiculo?      @relation(fields: [vehiculoId], references: [id], onDelete: SetNull)

  @@index([vehiculoId])
  @@index([estado])
  @@map("consultas")
}

model Configuracion {
  id                  String   @id @default("1")
  nombreConcesionaria String   @default("JBJ Automotores")
  telefono            String?
  email               String?
  direccion           String?
  facebookUrl         String?
  instagramUrl        String?
  horariosAtencion    String?
  updatedAt           DateTime @updatedAt
  cotizacionDolar     Decimal? @db.Decimal(10, 2)

  @@map("configuraciones")
}

enum Role {
  USER
  ADMIN
}

enum EstadoVehiculo {
  NUEVO
  USADO
}

enum EstadoPublicacion {
  BORRADOR
  PUBLICADO
  VENDIDO
  PAUSADO
}

enum Transmision {
  MANUAL
  AUTOMATICA
  CVT
}

enum Combustible {
  NAFTA
  DIESEL
  ELECTRICO
  HIBRIDO
  GNC
}

enum EstadoConsulta {
  PENDIENTE
  VISTA
  RESPONDIDA
  CERRADA
}

model PlanFinanciacion {
  id        String   @id @default(cuid())
  nombre    String
  cuotas    Int
  tasaAnual Decimal  @db.Decimal(5, 2)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("planes_financiacion")
}

model SolicitudFinanciacion {
  id         String         @id @default(cuid())
  vehiculoId String?
  nombre     String
  apellido   String
  dni        String
  email      String
  telefono   String
  ingresos   Decimal?       @db.Decimal(12, 2)
  anticipo   Decimal        @db.Decimal(12, 2)
  cuotas     Int
  estado     EstadoConsulta @default(PENDIENTE)
  mensaje    String?        @db.Text
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  vehiculo   Vehiculo?      @relation(fields: [vehiculoId], references: [id], onDelete: SetNull)

  @@index([vehiculoId])
  @@index([estado])
  @@map("solicitudes_financiacion")
}
